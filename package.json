{
  "name": "ish-anatomi",
  "version": "2.2.0",
  "private": true,
  "description": "ISH-Anatomi — local-first interactive 3D human anatomy and real-time ultrasound imaging desktop application with evidence-backed medical knowledge",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "atlas:bootstrap": "node scripts/bootstrap-human-atlas.mjs",
    "atlas:install": "npm --prefix vendor/human-atlas ci",
    "atlas:dev": "npm --prefix vendor/human-atlas run dev -- --host 127.0.0.1",
    "atlas:build": "npm --prefix vendor/human-atlas run build",
    "atlas:check": "npm --prefix vendor/human-atlas run check",
    "audit:architecture": "node scripts/architecture-audit.mjs",
    "audit:integration": "node scripts/integration-audit.mjs",
    "test": "node --check desktop/main.cjs && node --check desktop/preload.cjs && npm run audit:architecture && npm run audit:integration && node --test local-ai/*.test.mjs clinical/*.test.mjs clinical/*.test.cjs imaging/*.test.mjs probe/*.test.mjs knowledge/*.test.mjs camera/*.test.mjs",
    "test:python": "python -m unittest discover -s clinical -p 'test_*.py'",
    "desktop:dev": "electron .",
    "desktop:prepare": "npm run atlas:bootstrap && npm run atlas:install && npm run atlas:check && npm run atlas:build",
    "desktop:dist": "npm run desktop:prepare && electron-builder"
  },
  "engines": {"node": ">=22.13.0"},
  "devDependencies": {"electron": "^38.1.0", "electron-builder": "^26.0.12"},
  "build": {
    "appId": "com.ish.anatomi",
    "productName": "ISH-Anatomi",
    "asar": true,
    "files": [
      "desktop/**/*",
      "local-ai/**/*",
      "clinical/**/*",
      "imaging/**/*",
      "probe/**/*",
      "knowledge/**/*",
      "camera/**/*",
      "scripts/**/*",
      "package.json",
      "README.md",
      "docs/**/*",
      "vendor/human-atlas/dist/**/*",
      "vendor/human-atlas/package.json"
    ],
    "win": {"target": ["nsis"]},
    "linux": {"target": ["AppImage", "deb"]},
    "nsis": {"oneClick": false,"perMachine": false,"allowToChangeInstallationDirectory": true}
  },
  "license": "MIT"
}
